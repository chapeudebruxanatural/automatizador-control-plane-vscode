{
  "name": "automatizadoria-control-plane",
  "version": "0.1.0",
  "private": true,
  "description": "Control Plane privado da AutomatizadorIA",
  "type": "module",
  "engines": {
    "node": ">=20.11.0"
  },
  "scripts": {
    "dev": "tsx watch apps/api/src/main.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/apps/api/src/main.js",
    "worker": "tsx apps/worker/src/main.ts",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit",
    "test": "bash scripts/run-tests.sh",
    "scan:secrets": "bash scripts/scan-secrets.sh",
    "scan:secrets:all": "bash scripts/scan-secrets.sh --all",
    "verify": "npm run lint && npm run typecheck && npm test && npm run build",
    "governador": "node --import tsx scripts/governador-orcamento.mts"
  },
  "dependencies": {
    "yaml": "^2.7.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.18.0",
    "@types/node": "^22.10.5",
    "eslint": "^9.18.0",
    "globals": "^15.14.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0"
  }
}
