# =============================================================================
# AutomatizadorIA Control Plane — .gitignore
# Politica: negar por padrao tudo que possa carregar segredo, dado de cliente
# ou artefato de build. Ver SECURITY.md e docs/security/secrets-policy.md.
# =============================================================================

# --- Variaveis de ambiente ---------------------------------------------------
.env
.env.*
!.env.example
*.env
env/
.envrc
.direnv/

# --- Credenciais, tokens e chaves -------------------------------------------
credentials/
credential/
credentials.json
client_secret*.json
service-account*.json
gcp-*.json
google-credentials*.json
oauth*.json
token.json
tokens.json
*token*.json
*.token
.token
secrets/
secret/
secrets.json
secrets.yaml
secrets.yml
*.secret
*.secrets

# --- Chaves criptograficas e certificados -----------------------------------
*.pem
*.key
*.pkcs12
*.p12
*.pfx
*.jks
*.keystore
*.asc
*.gpg
*.kdbx
id_rsa*
id_dsa*
id_ecdsa*
id_ed25519*
*_rsa
*_ed25519
!*.pub.example
*.crt
*.cer
*.der
*.csr
authorized_keys
known_hosts
.ssh/

# --- Dumps e backups ---------------------------------------------------------
# ATENCAO: `backup/` e `backups/` sem barra inicial casam em QUALQUER
# profundidade — inclusive diretorios de CODIGO/DOCS que se chamam "backup"
# por coincidencia, como scripts/backup/ e docs/runbooks/backup/.
#
# Isso ja causou um incidente real duas vezes: os arquivos desses dois
# diretorios foram escritos, testados e believed-committed, mas o .gitignore
# os engoliu em silencio — `git add -A` nao avisa sobre arquivo ignorado.
# Corrigido com as negacoes explicitas logo abaixo.
#
# Antes de adicionar qualquer novo diretorio chamado backup/backups ao
# projeto (codigo ou doc), rode `git check-ignore -v <caminho>` e negue aqui
# se for codigo/doc versionavel. O padrao so deve bloquear DADO de backup em
# runtime, nunca os scripts ou a documentacao que os produzem.
*.sql
*.sql.gz
*.dump
*.dmp
dumps/
backup/
backups/
!scripts/backup/
!scripts/backup/**
!docs/runbooks/backup/
!docs/runbooks/backup/**
*.bak
*.backup
*.tar
*.tar.gz
*.tgz
*.zip
*.7z
*.rar
n8n-backup*/
db-backup*/

# --- Logs --------------------------------------------------------------------
*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
audit/*.jsonl
!audit/.gitkeep
var/
run/

# --- Temporarios e scratch ---------------------------------------------------
tmp/
temp/
.tmp/
.cache/
scratch/
scratchpad/
*.tmp
*.temp
*.swp
*.swo
*~
.#*
\#*#

# --- Build e dependencias ----------------------------------------------------
node_modules/
dist/
build/
out/
coverage/
.nyc_output/
*.tsbuildinfo
.turbo/
.next/
.vite/

# --- Sistema operacional -----------------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
desktop.ini

# --- Editores ----------------------------------------------------------------
.idea/
.vscode/*
!.vscode/extensions.json
*.sublime-workspace

# --- Claude Code -------------------------------------------------------------
# settings.local.json pode conter permissoes e caminhos locais especificos.
.claude/settings.local.json
.claude/local/

# --- Dados exportados de clientes / plataformas ------------------------------
exports/
downloads/
*.csv.private
clients/**/private/
clients/**/raw/
