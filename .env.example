# =============================================================================
# AutomatizadorIA Control Plane — exemplo de variaveis de ambiente
# =============================================================================
# Copie para .env e preencha localmente. O arquivo .env NUNCA e versionado.
# Nenhum valor real deve ser escrito neste arquivo de exemplo.
# Placeholders usam o formato <DESCRICAO> propositalmente, para que o scanner
# de segredos (scripts/scan-secrets.sh) nao os confunda com credenciais.
# =============================================================================

# --- Runtime -----------------------------------------------------------------
NODE_ENV=development
PORT=3000
LOG_LEVEL=info
SERVICE_NAME=control-plane-api

# --- Kill switch global ------------------------------------------------------
# Quando true (padrao), NENHUMA acao externa com efeito colateral e executada.
# Somente leitura e simulacao. Desligar exige aprovacao humana registrada.
CONTROL_PLANE_KILL_SWITCH=true

# Modo de execucao das acoes: dry-run | live
# dry-run e o padrao seguro. live so tem efeito com kill switch desligado.
EXECUTION_MODE=dry-run

# Exige aprovacao humana explicita para acoes de escrita.
REQUIRE_HUMAN_APPROVAL=true

# --- Auditoria ---------------------------------------------------------------
# Caminho do log de auditoria local (fica fora do versionamento).
AUDIT_LOG_PATH=./audit/audit.jsonl
AUDIT_SINK=memory

# =============================================================================
# INTEGRACOES — nenhuma esta habilitada nesta fase.
# As variaveis abaixo estao documentadas para planejamento. Mantenha vazias
# ate que o modulo correspondente seja aprovado e implementado.
# =============================================================================

# --- GitHub ------------------------------------------------------------------
# Preferencia: reutilizar o gh CLI ja autenticado no keychain, sem token em .env
GITHUB_AUTH_MODE=gh-cli
GITHUB_OWNER=dadocruz
GITHUB_TOKEN=

# --- VPS (Hostinger) ---------------------------------------------------------
# Autenticacao por chave SSH ja presente em ~/.ssh/config. Sem senha em .env.
VPS_SSH_ALIAS=nvvps
VPS_READ_ONLY=true

# --- n8n ---------------------------------------------------------------------
N8N_BASE_URL=
N8N_API_KEY=

# --- Cloudflare --------------------------------------------------------------
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# --- Google (conta administrativa canonica da AutomatizadorIA) ---------------
# Conta canonica: contato.automatizadoria@gmail.com
# NUNCA misturar com a conta Novacena (estudionovacena@gmail.com).
GOOGLE_ADMIN_ACCOUNT=contato.automatizadoria@gmail.com
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=

# --- Google (conta Novacena, escopo separado) --------------------------------
GOOGLE_NOVACENA_ACCOUNT=estudionovacena@gmail.com
GOOGLE_NOVACENA_CLIENT_ID=
GOOGLE_NOVACENA_CLIENT_SECRET=
GOOGLE_NOVACENA_REFRESH_TOKEN=

# --- Google Ads (conta de serviço) -------------------------------------------
# A chave da conta de serviço NÃO fica aqui nem no repositório: fica em disco,
# em ~/Documents/Codex/.secrets/google-ads/service-account.json com modo 600, e
# é lida por CAMINHO. Ver credential-provider.ts.
#
# Só o developer token vem por ambiente. login-customer-id é a MCC; a conta
# anunciante é filha dela e é compartilhada entre clientes — o isolamento por
# cliente é feito na allowlist de scope.ts, não aqui.
GOOGLE_ADS_DEVELOPER_TOKEN=
# Alternativa local preferida: arquivo modo 600; o valor nunca passa pelo .env.
GOOGLE_ADS_DEVELOPER_TOKEN_PATH=
GOOGLE_ADS_LOGIN_CUSTOMER_ID=3992594849
GOOGLE_ADS_CUSTOMER_ID=2656966896
GOOGLE_ADS_KEY_PATH=

# --- Meta (Facebook / Instagram Ads) -----------------------------------------
META_APP_ID=
META_APP_SECRET=
META_ACCESS_TOKEN=
META_DEFAULT_AD_ACCOUNT=

# --- WhatsApp (WhatsApp Cloud API — nao usado nesta fase) --------------------
# Mantido para planejamento futuro. O canal ativo hoje e a Evolution API
# (secao seguinte). Mantenha vazio.
WHATSAPP_ENABLED=false
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_VERIFY_TOKEN=

# --- WhatsApp via Evolution API (modulo em HOMOLOGACAO) ----------------------
# writeActionsEnabled e fixo em false no codigo (packages/integrations/src/
# evolution/index.ts) — nao existe flag aqui que habilite envio de mensagem.
# Preencher estas variaveis so habilita a LEITURA (comandos de consulta).
# Nao colar valor real no chat. Ver docs/runbooks/whatsapp-homologation.md.
EVOLUTION_API_URL=
EVOLUTION_API_KEY=
EVOLUTION_INSTANCE_NAME=
EVOLUTION_WEBHOOK_SECRET=
# Numeros separados por virgula, formato E.164 sem '+' (ex: 5511999999999).
# Vazio = allowlist vazia = nega todo mundo. Nunca inclua numero de cliente.
WHATSAPP_ALLOWED_NUMBERS=
WHATSAPP_RATE_LIMIT_PER_MINUTE=20
